# BMW LITE - Environment Variables (kwa Katabump/Pterodactyl Panel)
# Copy faili hii kwa jina ".env" KAMA unaitumia local, lakini kwenye Pterodactyl/Katabump
# unaweka hizi variable moja kwa moja kwenye "Startup" tab ya server yako (Variables section).

# Namba ya WhatsApp itakayotumika kupair bot (bila + mfano 255743383943)
# Ukiiacha tupu, utaweka namba kupitia dashboard (browser) baada ya bot kuanza.
PAIRING_NUMBER=255743383943

# Port - Pterodactyl/Katabump inajaza hii automatic (SERVER_PORT). USIIBADILISHE kwa mkono
# kwenye panel halisi; ipo hapa tu kwa rejea ya local testing.
SERVER_PORT=3000

# ===================== API KEYS (Hazihitajiki zote - weka unazohitaji) =====================

# GROQ AI - kwa .ai command, PRIMARY (free key: https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OPENROUTER AI - kwa .ai command, FALLBACK ikiwa Groq imeshindwa (free key: https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenWeatherMap - kwa weather command (free key: https://openweathermap.org/api)
WEATHER_API_KEY=

# Musixmatch - kwa lyrics command
LYRICS_API_KEY=

# NewsAPI - kwa news command (free key: https://newsapi.org/register)
NEWS_API_KEY=

# Google Translate
TRANSLATE_API_KEY=

# OMDB - kwa movie command (free key: https://omdbapi.com/apikey.aspx)
MOVIE_API_KEY=

# Spotify
SPOTIFY_API_KEY=

# ===================== ACCOUNTS (Create Account / Login) =====================
# MUHIMU: Node.js HAISOMI faili hili moja kwa moja - lazima uliweke kwenye
# Wispbyte/KataBump -> Startup -> Environment Variables (njia ya kuaminika
# zaidi), au tumia jina la faili hii kama ".env" halisi (tumekuongezea
# "dotenv" package ili hilo pia lifanye kazi).

# Neon Postgres connection string - inahitajika kwa Create Account/Login
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Herufi za nasibu ndefu (32+) kwa ajili ya login sessions (JWT)
JWT_SECRET=

# Hiari - kwa Welcome Email baada ya signup (Gmail App Password, Zoho, Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Premium Dashboard password (default 3006 ikiwa haujaweka)
PREMIUM_PASSWORD=
